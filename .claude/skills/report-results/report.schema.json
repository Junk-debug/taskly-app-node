{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "decisions",
    "tests",
    "suspectedBugs",
    "dropped"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "decision",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "create",
              "update",
              "skip"
            ]
          },
          "testFile": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "cases",
          "result",
          "runs"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "suspectedBugs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "description",
          "expected",
          "actual"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "case",
          "lastError"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "case": {
            "type": "string"
          },
          "lastError": {
            "type": "string"
          }
        }
      }
    }
  }
}
